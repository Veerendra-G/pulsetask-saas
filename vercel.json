{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/docs", "destination": "/api/docs" },
    { "source": "/openapi.json", "destination": "/api/openapi.json" },
    { "source": "/redoc", "destination": "/api/redoc" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
